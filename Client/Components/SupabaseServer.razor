@using DomainBasic.Models.Dto

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationService AuthService

<h2>Server</h2>
<h6>Projects: @projects.Count </h6>

<div class="d-flex flex-wrap">
    <div class="mx-auto"><OccurrenceCounts Field="Designers" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="Analysts" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="Architects" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="Tags" MaxItems="5" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="Skills" MaxItems="5" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="ProjectStatus" Projects="projects" /></div>
    <div class="mx-auto"><OccurrenceCounts Field="ProjectStage" Projects="projects" /></div>
</div>

<div>
    <NonEmptyCounts Field="BallparkHours" Projects="projects" />
</div>
<span>Error: @message</span>

@code {
    private List<Project> projects = new List<Project>();

    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        List<Task>? tasks = new List<Task>();
        tasks.Add(GetProjectsAsync());
        await Task.WhenAll(tasks);
    }


    private async Task GetProjectsAsync()
    {
        HttpClient? client = HttpClientFactory.CreateClient(name: "ApiClient");
        HttpRequestMessage? request = new HttpRequestMessage(
        HttpMethod.Get,
        requestUri: "/api/get-projects");
        request.Headers.Add(name: "apikey", AuthService.SupabaseKey);
        request.Headers.Add(name: "x-Authorization", value: $"Bearer {AuthService.AccessToken}"); // swa strips Authorization
        HttpResponseMessage? response = await client.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            string? json = await response.Content.ReadAsStringAsync();
            projects = await response.Content.ReadFromJsonAsync<List<Project>>()
            ?? new List<Project>();
            message = response.StatusCode.ToString();
        }
        else
        {
            message = $"{response.StatusCode.ToString()}. {await response.Content.ReadAsStringAsync()}";
        }
    }
}